// EPM Intelligence & Opportunity Hub — data model.
//
// Slice 1 uses: Client, Brief, BriefClient, Opportunity.
// The commented-out models are sketched so later slices (licenses, research
// agents, outreach) can be added without reworking the schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev = a SQLite file. Going hosted later = change provider to
  // "postgresql" and point DATABASE_URL at a hosted database.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A company we support (active) or want to win (prospect). Everything in the
// hub hangs off clients. `name` holds the CODE NAME — no real names stored, so
// it's safe to share screens and information.
model Client {
  id            String          @id @default(cuid())
  name          String // code name, e.g. "Falcon"
  type          String          @default("active") // "active" | "prospect"
  color         String          @default("#6366f1")
  hosting       String? // "SaaS Public" | "SaaS Private" | "On Premises"
  notes         String?
  ownerId       String          @default("me") // becomes a real user id once teammates log in
  createdAt     DateTime        @default(now())
  briefs        BriefClient[]
  opportunities Opportunity[]
  tasks         Task[]
  people        Person[]
  modules       ClientModule[]
}

// A Tagetik product/module in the catalogue (Consolidation, ETL, ESG, …).
model Module {
  id       String          @id @default(cuid())
  name     String          @unique
  clients  ClientModule[]
  briefs   BriefModule[]
  findings FindingModule[]
}

// A research source a source/agent monitors (an RSS/blog feed or web topic).
model Source {
  id            String    @id @default(cuid())
  name          String
  type          String    @default("rss") // "rss" (feed) | "web" (search topic)
  url           String    @default("") // feed URL for rss sources
  query         String? // search terms for web-research sources
  moduleHint    String? // optional: a module this source usually concerns
  instructions  String? // optional: extra steering for this specific source
  active        Boolean   @default(true)
  agentId       String?
  agent         Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
}

// A named research agent — a beat with its own briefing and its own mix of
// sources/briefs. Findings it produces are tagged back to it.
model Agent {
  id             String          @id @default(cuid())
  name           String
  mission        String          @default("")
  archetype      String          @default("finder") // finder | retriever | comparer
  briefing       String          @default("") // the instructions that drive it
  active         Boolean         @default(true)
  allowedDomains String? // comma-separated hostnames the web search may use
  blockedDomains String? // comma-separated hostnames to exclude
  maxItems       Int             @default(6)
  lookbackDays   Int             @default(30) // prefer items newer than this
  lastRunAt      DateTime?
  createdAt      DateTime        @default(now())
  sources        Source[]
  briefs         ResearchBrief[]
  findings       Finding[]
  runs           AgentRun[]
}

// One execution of an agent — the run log / history.
model AgentRun {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ranAt        DateTime @default(now())
  foundCount   Int      @default(0)
  highCount    Int      @default(0)
  medCount     Int      @default(0)
  lowCount     Int      @default(0)
  estCostCents Int      @default(0)
  status       String   @default("ok") // ok | nothing_new | error
  message      String?
}

// Simple key/value app settings (e.g. the global research instructions).
model Setting {
  key   String @id
  value String
}

// A research brief the agents work from (uploaded PDF/Word or typed text).
// Pressing "Run" sends the agents to research against it.
model ResearchBrief {
  id        String    @id @default(cuid())
  name      String
  content   String // extracted text of the brief
  agentId   String?
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
}

// A raw item picked up by the agents (or pasted in), waiting in the triage
// inbox. Approving one turns it into a Brief.
model Finding {
  id              String          @id @default(cuid())
  title           String
  summary         String          @default("")
  rawContent      String          @default("")
  sourceUrl       String?
  sourceType      String          @default("rss") // rss | paste | web | video
  externalId      String?         @unique // dedupe key (feed guid/link)
  publishedAt     DateTime?
  status          String          @default("pending") // pending | approved | dismissed
  aiProcessed     Boolean         @default(false)
  relevance       String          @default("medium") // high | medium | low
  relevanceReason String?
  agentId         String? // which agent surfaced it (null = pasted / ad-hoc)
  agent           Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  briefId         String? // set once approved into a Brief
  ownerId         String          @default("me")
  createdAt       DateTime        @default(now())
  modules         FindingModule[]
}

// Modules the summariser suggested a finding is about.
model FindingModule {
  findingId String
  moduleId  String
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([findingId, moduleId])
}

// A category of opportunity the firm defines for itself (you add your own).
model OpportunityCategory {
  id            String        @id @default(cuid())
  name          String        @unique
  opportunities Opportunity[]
}

// Which modules a client has, and whether they actively use it or just own the
// licence. "licensed" (owned, not in use) is a ready-made upsell signal.
model ClientModule {
  clientId String
  moduleId String
  status   String @default("in_use") // "in_use" | "licensed"
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([clientId, moduleId])
}

// A contact at a client, identified only by INITIALS for confidentiality.
model Person {
  id        String   @id @default(cuid())
  initials  String // e.g. "J.A."
  role      String? // e.g. "FP&A lead"
  notes     String?
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerId   String   @default("me")
  createdAt DateTime @default(now())
}

// A personal to-do — the daily heartbeat of the hub. Separate from TopDesk
// support tickets. "bookedInTeams" is a simple tick you set once you've put the
// task into your own Teams/Outlook calendar (no calendar integration).
model Task {
  id             String    @id @default(cuid())
  title          String
  notes          String?
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  urgency        String    @default("normal") // low | normal | high | urgent
  dueDate        DateTime?
  estimateMinutes Int? // "time consumption"
  bookedInTeams  Boolean   @default(false)
  done           Boolean   @default(false)
  ownerId        String    @default("me")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// A piece of intelligence: a vendor update, newsletter item, or video digest.
// Entered by hand in Slice 1; produced by research agents from Slice 3.
model Brief {
  id            String        @id @default(cuid())
  title         String
  summary       String        @default("")
  sourceUrl     String? // traceability: link back to the original
  sourceType    String        @default("manual") // manual | rss | newsletter | video | portal
  publishedAt   DateTime?
  ownerId       String        @default("me")
  createdAt     DateTime      @default(now())
  clients       BriefClient[]
  modules       BriefModule[]
  opportunities Opportunity[]
}

// Which modules a brief is about — drives "who's affected" via the client
// module mapping.
model BriefModule {
  briefId  String
  moduleId String
  brief    Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([briefId, moduleId])
}

// Many-to-many join: which clients a brief is relevant to.
model BriefClient {
  briefId  String
  clientId String
  brief    Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([briefId, clientId])
}

// A potential piece of work with a client or prospect — often sparked by a brief.
model Opportunity {
  id            String    @id @default(cuid())
  title         String
  description   String    @default("")
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  stage         String    @default("open") // open | pursuing | won | lost
  value         Int? // rough deal value, whole currency units
  likelihood    Int? // 0-100 %
  nextStep      String?
  deadline      DateTime?
  originBriefId String?
  originBrief   Brief?    @relation(fields: [originBriefId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      OpportunityCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ownerId       String    @default("me")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

