{
  "name": "epm-intel-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "presetup": "node scripts/ensure-env.mjs",
    "setup": "prisma generate && prisma migrate dev && prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "clients:add": "node scripts/add-clients.mjs",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "backup": "node scripts/backup.mjs",
    "update": "node scripts/update.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}
