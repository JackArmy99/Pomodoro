# Copy this file to `.env` and adjust as needed.
# Slice 1 only needs a local SQLite database.
DATABASE_URL="file:./dev.db"

# Claude API — enables AI summaries in the Research inbox. Get a key at
# console.anthropic.com (pay-as-you-go, separate from any Claude subscription).
# The app works without it; items just stay un-summarised.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"   # optional: override the summariser model

# Added in later slices (do NOT commit real values):
# SMTP_URL=""               # sending outreach emails (Slice 4)
